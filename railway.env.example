APP_NAME=Voidforge
APP_ENV=production
APP_DEBUG=false
APP_URL=https://voidforgestore.com
APP_KEY=base64:GENERATE_AND_SET_A_REAL_APP_KEY

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=${{mariadb.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=3306
DB_DATABASE=${{mariadb.MARIADB_DATABASE}}
DB_USERNAME=${{mariadb.MARIADB_USER}}
DB_PASSWORD=${{mariadb.MARIADB_PASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.voidforgestore.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=SET_IN_RAILWAY
MAIL_PORT=587
MAIL_USERNAME=SET_IN_RAILWAY
MAIL_PASSWORD=SET_IN_RAILWAY
MAIL_FROM_ADDRESS=no-reply@voidforgestore.com
MAIL_FROM_NAME=Voidforge

STRIPE_KEY=SET_IN_RAILWAY
STRIPE_SECRET=SET_IN_RAILWAY
STRIPE_WEBHOOK_SECRET=SET_IN_RAILWAY

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=SET_IN_RAILWAY
PAYPAL_CLIENT_SECRET=SET_IN_RAILWAY
PAYPAL_WEBHOOK_ID=SET_IN_RAILWAY

VITE_APP_NAME="${APP_NAME}"
