CERT_SERVER_NAMES="localhost 127.0.0.1"
CERT_ALT_NAMES="DNS:localhost,IP:127.0.0.1"
CERT_CRT_PATH=
CERT_KEY_PATH=

WWWUSER=65534
WWWGROUP=65534

DB_CONNECTION=mariadb
